{
  "expo": {
    "name": "Absensi Konsultan",
    "slug": "absensi-konsultan",
    "version": "1.0.0-beta.2",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "com.cloudabsen.app",
      "permissions": [
        "CAMERA",
        "ACCESS_FINE_LOCATION"
      ]
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Aplikasi memerlukan akses kamera untuk mengambil foto absensi.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Aplikasi memakai lokasi untuk mencatat koordinat pada foto absensi."
        }
      ],
      "expo-document-picker",
      "expo-notifications",
      "expo-status-bar",
      "expo-font"
    ]
  }
}

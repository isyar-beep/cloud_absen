# Server
PORT=5000
NODE_ENV=development

# Zona waktu -- menentukan tanggal absensi & perhitungan batas terlambat (08:00)
# WIB=Asia/Jakarta, WITA=Asia/Makassar, WIT=Asia/Jayapura
TZ=Asia/Jakarta

# CORS -- daftar origin frontend yang diizinkan (pisahkan dengan koma)
CORS_ORIGIN=http://localhost:5173

# Database PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cloud_absen
DB_USER=postgres
DB_PASSWORD=postgres

# JWT
JWT_SECRET=ganti_dengan_secret_yang_kuat
JWT_EXPIRES_IN=7d

# Firebase Admin SDK (Storage foto absensi)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_STORAGE_BUCKET=

# SMTP (opsional -- untuk notifikasi email peringatan attendance rendah)
# Kosongkan jika belum dipakai; fitur email otomatis nonaktif
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

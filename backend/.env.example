# Server
PORT=5000
NODE_ENV=development

# Zona waktu -- menentukan tanggal absensi, batas terlambat, dan cap waktu
# yang ditanam di foto absensi.
# WITA=Asia/Makassar, WIB=Asia/Jakarta, WIT=Asia/Jayapura
TZ=Asia/Makassar

# CORS -- daftar origin frontend yang diizinkan (pisahkan dengan koma)
CORS_ORIGIN=http://localhost:5173

# Database PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cloud_absen
DB_USER=postgres
DB_PASSWORD=postgres
# DB_HOST_PORT: port yang di-expose docker-compose ke host (dipakai container Postgres).
# Isi ini SAMA DENGAN DB_PORT di atas. Ganti keduanya (mis. ke 5433) kalau port 5432
# di komputer Anda sudah dipakai PostgreSQL lain (umum terjadi di Windows).
DB_HOST_PORT=5432

# JWT
JWT_SECRET=ganti_dengan_secret_yang_kuat
JWT_EXPIRES_IN=7d

# Penyimpanan foto absensi (disk lokal server)
# UPLOAD_DIR: folder tujuan (default: backend/uploads jika dikosongkan)
# PUBLIC_BASE_URL: domain API publik, dipakai untuk membentuk URL foto lengkap
# (mis. https://api.domainanda.com). Kosongkan untuk pakai path relatif saja.
UPLOAD_DIR=
PUBLIC_BASE_URL=

# SMTP (opsional -- untuk notifikasi email peringatan attendance rendah)
# Kosongkan jika belum dipakai; fitur email otomatis nonaktif
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
